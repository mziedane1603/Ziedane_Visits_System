rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== تعريفات الأدوار =====
    function pad2(n) { return (n < 10 ? '0' : '') + string(n); }
    function isoDate(t) { return string(t.year()) + '-' + pad2(t.month()) + '-' + pad2(t.day()); }

    function isSignedIn() { return request.auth != null; }
    function profileDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    // موظف = مستخدم عنده مستند في users وحسابه مش موقوف (حسابات العملاء مالهاش مستند هناك)
    function isStaff() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profileDoc().data.get('active', true) != false;
    }
    function myProfile() { return profileDoc().data; }
    function myRole() { return isStaff() ? myProfile().role : null; }
    function isAdmin() { return myRole() == 'admin'; }
    function isManager() { return myRole() == 'manager'; }
    function isAdminOrManager() { return isAdmin() || isManager(); }
    function myUsername() { return myProfile().username; }
    function myRepId() { return myProfile().get('repId', null); }
    function isRep() { return myRole() == 'rep' && myRepId() != null; }
    // عميل بوابة = مسجّل دخول وعنده مستند في customerPortal وملوش مستند موظف
    function isCustomer() { return isSignedIn() && !exists(/databases/$(database)/documents/users/$(request.auth.uid)) && exists(/databases/$(database)/documents/customerPortal/$(request.auth.uid)); }
    function myKey() { return get(/databases/$(database)/documents/customerPortal/$(request.auth.uid)).data.code; }

    // ===== نطاق المدن: المندوب (من مستند reps) والتلي سيلز (من مستند users) =====
    // قايمة فاضية = كل المدن (نفس سلوك التطبيق). لو عايز تمنع المندوب من غير مدن، غيّر الشرط size() == 0 إلى false.
    function myCities() {
      return isRep() ? get(/databases/$(database)/documents/reps/$(myRepId())).data.get('cities', [])
           : (myRole() == 'telesales' ? myProfile().get('cities', []) : []);
    }
    function inMyCities(city) { return isAdminOrManager() || myCities().size() == 0 || city in myCities(); }
    function sameCity() { return isStaff() && inMyCities(resource.data.get('city', '')); }

    // ===== المستخدمون: كل واحد يقرا مستنده، والإدارة تقرا الكل =====
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdminOrManager());
      allow create, delete: if isAdmin();
      // المستخدم يحدّث حضوره، ويقدر يقفل علم "لازم يغيّر كلمة المرور" (يتحط false بس) بعد ما يغيّرها
      allow update: if isAdmin() ||
        (isStaff() && request.auth.uid == uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt','currentPage','mustChangePassword']) &&
         (!('mustChangePassword' in request.resource.data.diff(resource.data).affectedKeys()) ||
          request.resource.data.mustChangePassword == false));
    }

    // ===== إعدادات النظام =====
    match /appConfig/{id} {
      // version و branding (اسم الشركة + لوجو صغير) مقروءين قبل تسجيل الدخول، والباقي للموظفين
      allow read: if id == 'version' || id == 'branding' || isStaff();
      // الأدمن يكتب أي إعداد، والمدير يعدّل قواعد الحوافز وحدود المدن بس
      allow write: if isAdmin() || (isManager() && id in ['repBonusRules','cityThresholds','intelCfg','cityTargets']);
    }

    // ===== محادثة الفريق =====
    match /teamChat/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.senderUsername == myUsername();
      allow delete: if isAdminOrManager() || (isStaff() && resource.data.senderUsername == myUsername());
      allow update: if false;
    }

    // ===== النسخ الاحتياطي =====
    match /systemBackups/{date} {
      allow read: if isAdminOrManager();
      allow write: if isAdmin();
      match /chunks/{cid} {
        allow read: if isAdminOrManager();
        allow write: if isAdmin();
      }
    }

    // ===== الزيارات =====
    // المندوب يقرا زياراته هو بس (الاستعلام لازم يحتوي where repId == ...)، والإدارة والتلي سيلز يقروا الكل
    match /visits/{id} {
      allow read: if isAdminOrManager() || myRole() == 'telesales'
        || (isRep() && resource.data.get('repId', '') == myRepId());
      allow create: if isAdminOrManager()
        || (isRep() && request.resource.data.repId == myRepId()
            && request.resource.data.keys().hasOnly(['repId','customerCode','customerName','city','area','paymentStatus','visitResult','rating','date','createdAt','createdBy'])
            && request.resource.data.keys().hasAll(['repId','customerCode','date','createdAt','createdBy'])
            && request.resource.data.createdBy == myUsername()
            && request.resource.data.createdAt == request.time
            && request.resource.data.date is string
            && request.resource.data.date.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
            // (1) id ثابت = مندوب_تاريخ_كود: التكرار بيتحوّل لـ update والـ update ممنوع للمندوب
            && (id == request.resource.data.repId + '_' + request.resource.data.date + '_' + request.resource.data.customerCode
                || request.resource.data.customerCode.matches('.*/.*') || request.resource.data.repId.matches('.*/.*'))
            // (2) التاريخ لازم يكون قريب من وقت السيرفر: من 7 أيام فاتت لحد بكرة (7 أيام عشان الزيارات اللي بتتسجل أوفلاين وتترفع بعدين)
            && request.resource.data.date >= isoDate(request.time - duration.value(7, 'd'))
            && request.resource.data.date <= isoDate(request.time + duration.value(1, 'd'))
            && (!('rating' in request.resource.data) || (request.resource.data.rating is number && request.resource.data.rating >= 0 && request.resource.data.rating <= 10)));
      allow update, delete: if isAdmin();
    }

    // ===== خطة الزيارات =====
    match /plannedVisits/{id} {
      allow read: if isStaff();
      allow create: if isAdminOrManager()
        || (isRep() && request.resource.data.repId == myRepId());
      allow update: if isAdmin();
      allow delete: if isAdminOrManager()
        || (isRep() && resource.data.repId == myRepId());
    }

    // ===== متابعات التلي سيلز =====
    match /followups/{id} {
      allow read: if isStaff();
      allow create: if isAdminOrManager()
        || (isStaff() && myRole() == 'telesales' && request.resource.data.telesalesUsername == myUsername());
      allow update, delete: if isAdmin();
    }

    // ===== طلبات المناديب للإدارة (خصم/استثناء، موافقة، تحصيل...) =====
    match /repRequests/{id} {
      allow read: if isAdminOrManager() || (isStaff() && resource.data.createdBy == myUsername());
      allow create: if isStaff()
        && request.resource.data.createdBy == myUsername()
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['createdBy','repId','repName','type','text','status','createdAt','customerCode','customerName','city'])
        && request.resource.data.text is string && request.resource.data.text.size() > 2 && request.resource.data.text.size() <= 600;
      allow update: if isAdminOrManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reply','repliedBy','repliedByName','repliedAt'])
        && request.resource.data.status in ['approved','rejected','call','wait'];
      allow delete: if isAdmin();
    }

    // ===== الطلبيات المقترحة من المناديب =====
    match /suggestedOrders/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.repUsername == myUsername();
      allow update, delete: if isAdminOrManager();
    }

    // ===== بيانات العملاء اللي بيسجلها المناديب =====
    match /customerData/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff() && request.resource.data.updatedBy == myUsername();
      allow delete: if isAdmin();
    }

    // ===== سجل التعديلات: إضافة فقط، بشكل ثابت، وبهوية المستخدم الحقيقية (مينفعش يتزوّر) =====
    match /auditLog/{id} {
      allow read: if isAdminOrManager();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['action','collection','label','userName','userRole','timestamp'])
        && request.resource.data.keys().hasAll(['action','userName','userRole','timestamp'])
        && request.resource.data.userRole == myRole()
        && request.resource.data.userName in [myProfile().get('name', ''), myUsername()]
        && request.resource.data.timestamp == request.time
        && request.resource.data.action is string && request.resource.data.action.size() <= 200
        && (!('label' in request.resource.data) || (request.resource.data.label is string && request.resource.data.label.size() <= 500))
        && (!('collection' in request.resource.data) || (request.resource.data.collection is string && request.resource.data.collection.size() <= 100));
      allow update, delete: if false;
    }

    // ===== بيانات مرجعية عامة للموظفين: كتابة للأدمن =====
    match /reps/{id}               { allow read: if isStaff(); allow write: if isAdmin(); }
    match /visitResults/{id}       { allow read: if isStaff(); allow write: if isAdmin(); }
    match /followupResults/{id}    { allow read: if isStaff(); allow write: if isAdmin(); }
    match /announcements/{id}      { allow read: if isStaff(); allow write: if isAdmin(); }
    match /inventory/{id}          { allow read: if isStaff(); allow write: if isAdmin(); }
    match /bonusOffers/{id}        { allow read: if isStaff(); allow write: if isAdmin(); }
    match /orderTemplates/{id}     { allow read: if isStaff(); allow write: if isAdmin(); }

    // ===== بيانات مقيّدة بمدن المستخدم (الاستعلام لازم يحتوي where city == ...) =====
    match /customers/{id}          { allow read: if sameCity(); allow write: if isAdmin(); }
    match /claims/{id}             { allow read: if sameCity(); allow write: if isAdmin(); }
    match /usage/{id} {
      allow read: if isAdmin();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['username','role','date','counts'])
        && request.resource.data.username == myUsername()
        && id == request.resource.data.date + '_' + myUsername();
    }
    match /agreements/{id}         { allow read: if sameCity(); allow write: if isAdminOrManager(); }
    match /customerSales/{id}      { allow read: if sameCity(); allow write: if isAdmin(); }
    match /citySales/{id}          { allow read: if sameCity(); allow write: if isAdmin(); }
    // تحليلات المبيعات: للإدارة فقط
    match /salesAnalytics/{id}     { allow read: if isAdminOrManager(); allow write: if isAdmin(); }

    // ===== المنافسة والمسابقات: ملخصات مجمّعة (أرقام إجمالية بس)، الكل يقرا والإدارة تكتب =====
    match /leaderboard/{id}        { allow read: if isStaff(); allow write: if isAdminOrManager(); }
    match /contests/{id}           { allow read: if isStaff(); allow write: if isAdminOrManager(); }

    // ===== مهام الكليندر: خاصة بصاحبها بس (الأدمن يقدر يحذف) =====
    match /repTasks/{id} {
      allow read: if isStaff() && resource.data.get('owner', '') == myUsername();
      allow create: if isStaff() && request.resource.data.owner == myUsername()
        && request.resource.data.keys().hasOnly(['owner','title','note','date','time','remind','repeat','customerCode','customerName','doneDates','createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200;
      allow update: if isStaff() && resource.data.owner == myUsername() && request.resource.data.owner == myUsername()
        && request.resource.data.keys().hasOnly(['owner','title','note','date','time','remind','repeat','customerCode','customerName','doneDates','createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200;
      allow delete: if isStaff() && (resource.data.owner == myUsername() || isAdmin());
    }

    // ===== بوابة العملاء =====
    match /catalog/{id} {
      allow read: if isStaff() || isCustomer();
      allow write: if isAdmin();
    }
    match /portalAccounts/{key} {
      allow read: if isStaff() || (isCustomer() && myKey() == key);
      allow write: if isAdmin();
    }
    match /customerPortal/{uid} {
      allow read: if isStaff() || request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.keys().hasOnly(['code','pwChanged','createdAt'])
        && request.resource.data.pwChanged == false
        && request.auth.token.email == request.resource.data.code + '@portal.apc.local'
        && exists(/databases/$(database)/documents/portalAccounts/$(request.resource.data.code))
        && get(/databases/$(database)/documents/portalAccounts/$(request.resource.data.code)).data.active == true;
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pwChanged']);
      allow delete: if isAdmin();
    }
    match /portalOrders/{id} {
      allow create: if isCustomer()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.acctKey == myKey()
        && request.resource.data.status == 'new'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 300
        && get(/databases/$(database)/documents/portalAccounts/$(myKey())).data.active == true;
      allow read: if isStaff() || (isCustomer() && resource.data.uid == request.auth.uid);
      allow update: if isStaff();
      allow delete: if isAdminOrManager();
    }

    // أي مجموعة تانية مش مذكورة فوق: مرفوضة (deny by default)
  }
}
