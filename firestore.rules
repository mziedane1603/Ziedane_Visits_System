rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== تعريفات الأدوار =====
    function isSignedIn() { return request.auth != null; }
    function profileDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    // موظف = مستخدم عنده مستند في users وحسابه مش موقوف (حسابات العملاء مالهاش مستند هناك)
    function isStaff() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profileDoc().data.get('active', true) != false;
    }
    function myProfile() { return profileDoc().data; }
    function myRole() { return isStaff() ? myProfile().role : null; }
    function isAdmin() { return myRole() == 'admin'; }
    function isManager() { return myRole() == 'manager'; }
    function isAdminOrManager() { return isAdmin() || isManager(); }
    function myUsername() { return myProfile().username; }
    function myRepId() { return myProfile().get('repId', null); }
    // عميل بوابة = مسجّل دخول وعنده مستند في customerPortal وملوش مستند موظف
    function isCustomer() { return isSignedIn() && !exists(/databases/$(database)/documents/users/$(request.auth.uid)) && exists(/databases/$(database)/documents/customerPortal/$(request.auth.uid)); }
    function myKey() { return get(/databases/$(database)/documents/customerPortal/$(request.auth.uid)).data.code; }

    // ===== المستخدمون =====
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow create, delete: if isAdmin();
      // المستخدم يحدّث حضوره، ويقدر يقفل علم "لازم يغيّر كلمة المرور" (يتحط false بس) بعد ما يغيّرها
      allow update: if isAdmin() ||
        (isStaff() && request.auth.uid == uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt','currentPage','mustChangePassword']) &&
         (!('mustChangePassword' in request.resource.data.diff(resource.data).affectedKeys()) ||
          request.resource.data.mustChangePassword == false));
    }

    // ===== إعدادات النظام =====
    match /appConfig/{id} {
      // version و branding (اسم الشركة + لوجو صغير) مقروءين قبل تسجيل الدخول، والباقي للموظفين
      allow read: if id == 'version' || id == 'branding' || isStaff();
      // الأدمن يكتب أي إعداد، والمدير يعدّل قواعد الحوافز وحدود المدن بس
      allow write: if isAdmin() || (isManager() && id in ['repBonusRules','cityThresholds']);
    }

    // ===== محادثة الفريق =====
    match /teamChat/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.senderUsername == myUsername();
      allow delete: if isAdminOrManager() || (isStaff() && resource.data.senderUsername == myUsername());
      allow update: if false;
    }

    // ===== النسخ الاحتياطي (مجموعة فرعية chunks جواها) =====
    match /systemBackups/{date} {
      allow read: if isAdminOrManager();
      allow write: if isAdmin();
      match /chunks/{cid} {
        allow read: if isAdminOrManager();
        allow write: if isAdmin();
      }
    }

    // ===== الزيارات: المندوب يسجّل زياراته هو بس، والتعديل والحذف للأدمن =====
    match /visits/{id} {
      allow read: if isStaff();
      allow create: if isAdminOrManager()
        || (isStaff() && myRole() == 'rep' && myRepId() != null && request.resource.data.repId == myRepId());
      allow update, delete: if isAdmin();
    }

    // ===== خطة الزيارات =====
    match /plannedVisits/{id} {
      allow read: if isStaff();
      allow create: if isAdminOrManager()
        || (isStaff() && myRole() == 'rep' && myRepId() != null && request.resource.data.repId == myRepId());
      allow update: if isAdmin();
      allow delete: if isAdminOrManager()
        || (isStaff() && myRole() == 'rep' && myRepId() != null && resource.data.repId == myRepId());
    }

    // ===== متابعات التلي سيلز =====
    match /followups/{id} {
      allow read: if isStaff();
      allow create: if isAdminOrManager()
        || (isStaff() && myRole() == 'telesales' && request.resource.data.telesalesUsername == myUsername());
      allow update, delete: if isAdmin();
    }

    // ===== الطلبيات المقترحة من المناديب =====
    match /suggestedOrders/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.repUsername == myUsername();
      allow update, delete: if isAdminOrManager();
    }

    // ===== بيانات العملاء اللي بيسجلها المناديب (رخصة، كود مكاني...) =====
    match /customerData/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff() && request.resource.data.updatedBy == myUsername();
      allow delete: if isAdmin();
    }

    // ===== سجل التعديلات: إضافة فقط (مفيش تعديل ولا حذف) والقراءة للإدارة =====
    match /auditLog/{id} {
      allow read: if isAdminOrManager();
      allow create: if isStaff() && request.resource.data.userName is string;
      allow update, delete: if false;
    }

    // ===== بيانات مرجعية: قراءة للموظفين، وكتابة للأدمن (الاستيراد والتعريفات) =====
    match /reps/{id}               { allow read: if isStaff(); allow write: if isAdmin(); }
    match /customers/{id}          { allow read: if isStaff(); allow write: if isAdmin(); }
    match /claims/{id}             { allow read: if isStaff(); allow write: if isAdmin(); }
    match /visitResults/{id}       { allow read: if isStaff(); allow write: if isAdmin(); }
    match /followupResults/{id}    { allow read: if isStaff(); allow write: if isAdmin(); }
    match /announcements/{id}      { allow read: if isStaff(); allow write: if isAdmin(); }
    match /customerSales/{id}      { allow read: if isStaff(); allow write: if isAdmin(); }
    match /citySales/{id}          { allow read: if isStaff(); allow write: if isAdmin(); }
    match /salesAnalytics/{id}     { allow read: if isStaff(); allow write: if isAdmin(); }
    match /inventory/{id}          { allow read: if isStaff(); allow write: if isAdmin(); }
    match /bonusOffers/{id}        { allow read: if isStaff(); allow write: if isAdmin(); }
    match /orderTemplates/{id}     { allow read: if isStaff(); allow write: if isAdmin(); }

    // ===== بوابة العملاء =====
    // كتالوج الأصناف (أسعار وخصومات وبونص بدون كميات): العميل والموظف يقرأوا، الأدمن بس ينشر
    match /catalog/{id} {
      allow read: if isStaff() || isCustomer();
      allow write: if isAdmin();
    }
    // قايمة الأكواد المسموح لها تدخل البوابة: العميل يقرأ بياناته هو بس
    match /portalAccounts/{key} {
      allow read: if isStaff() || (isCustomer() && myKey() == key);
      allow write: if isAdmin();
    }
    // ربط حساب الدخول بكود العميل: بيتعمل مرة واحدة أول دخول، ومربوط بإيميل الحساب نفسه
    match /customerPortal/{uid} {
      allow read: if isStaff() || request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.keys().hasOnly(['code','pwChanged','createdAt'])
        && request.resource.data.pwChanged == false
        && request.auth.token.email == request.resource.data.code + '@portal.apc.local'
        && exists(/databases/$(database)/documents/portalAccounts/$(request.resource.data.code))
        && get(/databases/$(database)/documents/portalAccounts/$(request.resource.data.code)).data.active == true;
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pwChanged']);
      allow delete: if isAdmin();
    }
    // طلبيات العملاء: العميل يضيف ويقرأ طلبياته بس، والموظفين يقروا ويحدّثوا الحالة
    match /portalOrders/{id} {
      allow create: if isCustomer()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.acctKey == myKey()
        && request.resource.data.status == 'new'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 300
        && get(/databases/$(database)/documents/portalAccounts/$(myKey())).data.active == true;
      allow read: if isStaff() || (isCustomer() && resource.data.uid == request.auth.uid);
      allow update: if isStaff();
      allow delete: if isAdminOrManager();
    }

    // أي مجموعة تانية مش مذكورة فوق: مرفوضة (deny by default)
  }
}
